# Secrets and API keys
.env
.env.*
!.env.example

# Raw, unprocessed data. Keep the directory itself so the repository layout is
# visible after cloning, but do not commit downloaded assets.
data/raw/*
!data/raw/.gitkeep

# Large binary model artifacts
models/*.bin

# Account-specific fine-tuned model pointer (written by the fine-tune job)
models/model_id.txt

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env/

# Web app: dependencies and build output
app/node_modules/
app/dist/
app/.vite/

# The downloaded CC0 models are committed on purpose: they are only ~5 MB and
# shipping them keeps the deployed build from depending on kenney.nl being up.
# scripts/setup_assets.py still regenerates them from scratch.

# OS and editor cruft
.DS_Store
.ipynb_checkpoints/
